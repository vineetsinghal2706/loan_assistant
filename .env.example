# ==========================================================
# DemoBank Loan Eligibility Assistant - example configuration
# Copy to .env and edit. NEVER commit a real .env file.
# ==========================================================

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Anthropic Claude ---
# If unset, the assistant falls back to a deterministic template
# explainer so the demo and CI can run fully offline.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=900
CLAUDE_TEMPERATURE=0.2
# Set to false to force the offline template explainer even when a key exists.
ENABLE_LLM=true

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# hash | sentence-transformers | auto
EMBEDDING_BACKEND=auto
# chroma | memory | auto
VECTOR_BACKEND=auto
CHROMA_DIR=./var/chroma
CHROMA_COLLECTION=demobank_policies
RETRIEVAL_TOP_K=5

# --- Policy / rules ---
DEFAULT_POLICY_VERSION=2.0

# --- Audit ---
AUDIT_DB_URL=sqlite:///./var/audit.db

# --- UI ---
API_BASE_URL=http://localhost:8000
