# =====================================================================
# DemoBank Loan Eligibility Assistant - Streamlit UI image
# =====================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# The UI only needs an HTTP client, Streamlit and pandas.
RUN pip install --upgrade pip \
    && pip install "streamlit>=1.35.0" "requests>=2.32.0" "pandas>=2.2.0"

COPY ui ./ui

RUN useradd --create-home --uid 10002 demoui && chown -R demoui:demoui /app
USER demoui

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
